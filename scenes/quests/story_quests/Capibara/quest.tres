[resource]
script = ExtResource("1_xxb21")
title = "El Capibara y Los Ovillos de Lana"
description = "Un capibara  sastre estaba decidido a terminar sus vestidos para el gran concurso, a pesar de carecer de tiempo y materiales. Su determinación era tan fuerte que conmovió a un misterioso viajero, quien le obsequió una máquina telar y le reveló el secreto para triunfar: la legendaria lana mágica.
Para conseguirla, el capibara deberá enfrentarse a desafiantes pruebas, guiado por su voluntad inquebrantable y el sueño de triunfar."
